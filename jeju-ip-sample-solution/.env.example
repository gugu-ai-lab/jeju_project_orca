# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요.
# VITE_ 로 시작하는 값만 브라우저에 들어갑니다 (공개돼도 되는 값만!)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 아래는 서버(/api)에서만 쓰는 비밀 키 — 절대 VITE_ 를 붙이지 마세요
DATA_GO_KR_KEY=
ANTHROPIC_API_KEY=  # 미사용: 공용 Claude 예산을 사용하지 않음


# 앱 서버 전용. VITE_ 접두사 금지
OPENAI_API_KEY=

# 앱 서버에서 사용할 모델
OPENAI_MODEL=gpt-6-luna

# 관리자 방명록 삭제 기능 (서버 전용, VITE_ 접두사 금지)
GUESTBOOK_ADMIN_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=

# 카카오 지도 선택 기능의 브라우저용 JavaScript 키
VITE_KAKAO_MAP_KEY=

# 통합 안전 미리보기에서만 true. 실제 인증과 즐겨찾기 요청을 차단합니다.
VITE_INTEGRATION_READ_ONLY=false
